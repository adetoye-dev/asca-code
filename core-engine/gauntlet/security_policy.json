{
  "$schema": "https://acsa-code.dev/schemas/security_policy.schema.json",

  "_meta": {
    "version": "1.0.0",
    "description": "Execution sandbox policy for AI-generated code. The runner requires OS-level isolation before launching generated code and combines it with environment sanitization to block direct filesystem, network, and process access unless the host provides the required primitives.",
    "enforced_by": "core-engine/gauntlet/load_sandbox.py (OS-level isolation + environment sanitization)",
    "last_updated": "2026-09-01T00:00:00Z"
  },

  "filesystem": {
    "chroot": {
      "enabled": true,
      "description": "Restrict all generated code execution to a randomized temporary directory. The sandbox process MUST NOT have write access outside this path.",

      "base_paths": {
        "linux": "/tmp",
        "darwin": "/tmp",
        "windows": "%TEMP%"
      },

      "directory_pattern": "aide_sandbox_{pid}_{random8}",
      "random_suffix_length": 8,
      "auto_cleanup": true,
      "cleanup_on_crash": true,
      "max_directory_size_mb": 512,

      "allowed_read_paths": [
        "{chroot_dir}/**",
        "{project_root}/**"
      ],

      "allowed_write_paths": [
        "{chroot_dir}/**"
      ],

      "denied_paths_always": [
        "/",
        "/bin",
        "/sbin",
        "/usr",
        "/etc",
        "/var",
        "/System",
        "/Library",
        "/Applications",
        "/boot",
        "/dev",
        "/proc",
        "/sys",
        "/root",
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.kube",
        "~/.config",
        "~/.local/share",
        "~/.bash_history",
        "~/.zsh_history",
        "C:\\Windows",
        "C:\\Program Files",
        "C:\\Program Files (x86)",
        "C:\\ProgramData",
        "C:\\Users\\*\\AppData\\Roaming"
      ]
    },

    "temp_file_rules": {
      "max_open_files": 256,
      "max_single_file_size_mb": 50,
      "allowed_extensions": [
        ".py", ".js", ".ts", ".tsx", ".jsx",
        ".json", ".yaml", ".yml", ".toml",
        ".html", ".css", ".sql",
        ".txt", ".md", ".csv", ".log",
        ".env", ".cfg", ".ini", ".xml"
      ],
      "denied_extensions": [
        ".exe", ".dll", ".so", ".dylib",
        ".sh", ".bat", ".cmd", ".ps1", ".vbs",
        ".app", ".dmg", ".msi", ".deb", ".rpm",
        ".ko", ".sys", ".kext",
        ".pem", ".key", ".crt", ".p12"
      ],
      "deny_symlinks": true,
      "deny_hardlinks": true,
      "deny_fifos": true,
      "deny_device_files": true
    }
  },

  "environment": {
    "sanitation": {
      "enabled": true,
      "description": "Strip all inherited environment variables and replace with a minimal, safe set. Blocks shell-injection vectors that rely on PATH, LD_PRELOAD, or DYLD hijacking.",

      "inherit_from_host": false,

      "stripped_variables": [
        "PATH",
        "LD_PRELOAD",
        "LD_LIBRARY_PATH",
        "DYLD_INSERT_LIBRARIES",
        "DYLD_LIBRARY_PATH",
        "DYLD_FALLBACK_LIBRARY_PATH",
        "DYLD_FRAMEWORK_PATH",
        "PYTHONPATH",
        "PYTHONSTARTUP",
        "PYTHONHOME",
        "NODE_PATH",
        "NODE_OPTIONS",
        "NODE_EXTRA_CA_CERTS",
        "PERL5LIB",
        "RUBYLIB",
        "GEM_HOME",
        "GOPATH",
        "CARGO_HOME",
        "JAVA_HOME",
        "CLASSPATH",
        "SHELL",
        "EDITOR",
        "VISUAL",
        "BROWSER",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "SSH_AUTH_SOCK",
        "SSH_AGENT_PID",
        "GPG_AGENT_INFO",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "AZURE_CLIENT_SECRET",
        "GITHUB_TOKEN",
        "GITLAB_TOKEN",
        "NPM_TOKEN",
        "DOCKER_HOST",
        "KUBECONFIG",
        "DATABASE_URL",
        "REDIS_URL",
        "SMTP_PASSWORD",
        "API_KEY",
        "SECRET_KEY",
        "PRIVATE_KEY",
        "http_proxy",
        "https_proxy",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "no_proxy",
        "NO_PROXY"
      ],

      "injected_variables": {
        "PATH": "/usr/bin:/usr/local/bin",
        "HOME": "{chroot_dir}",
        "TMPDIR": "{chroot_dir}/tmp",
        "TEMP": "{chroot_dir}/tmp",
        "TMP": "{chroot_dir}/tmp",
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8",
        "TERM": "dumb",
        "PORT": "{assigned_port}",
        "HOST": "127.0.0.1",
        "NODE_ENV": "production",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "AIDE_SANDBOX": "1",
        "AIDE_SANDBOX_ID": "{sandbox_id}",
        "AIDE_CHROOT_DIR": "{chroot_dir}",
        "AIDE_MAX_RUNTIME_SECONDS": "{max_runtime}"
      },

      "windows_overrides": {
        "PATH": "C:\\Python312;C:\\Windows\\System32",
        "SYSTEMROOT": "C:\\Windows",
        "COMSPEC": "C:\\Windows\\System32\\cmd.exe"
      }
    }
  },

  "network": {
    "egress_policy": {
      "enabled": true,
      "description": "Block all outbound network traffic from sandbox processes except for local loopback on the assigned test port. Generated code must NEVER contact external endpoints during automated testing.",

      "default_action": "deny",

      "allowed_connections": [
        {
          "description": "Generated application's own HTTP listener",
          "host": "127.0.0.1",
          "port_range": "9100-9200",
          "protocol": "tcp",
          "direction": "loopback"
        },
        {
          "description": "OS-assigned ephemeral fallback range",
          "host": "127.0.0.1",
          "port_range": "49152-65535",
          "protocol": "tcp",
          "direction": "loopback"
        },
        {
          "description": "DNS resolution (localhost only)",
          "host": "127.0.0.1",
          "port_range": "53",
          "protocol": "udp",
          "direction": "loopback"
        }
      ],

      "denied_connections": [
        {
          "description": "All external IPv4",
          "host": "0.0.0.0/0",
          "port_range": "*",
          "protocol": "any",
          "direction": "outbound"
        },
        {
          "description": "All external IPv6",
          "host": "::/0",
          "port_range": "*",
          "protocol": "any",
          "direction": "outbound"
        },
        {
          "description": "Metadata service endpoints (cloud VM escape vector)",
          "host": "169.254.169.254",
          "port_range": "80,443",
          "protocol": "tcp",
          "direction": "outbound"
        },
        {
          "description": "Docker daemon socket bypass",
          "host": "172.17.0.0/16",
          "port_range": "*",
          "protocol": "any",
          "direction": "outbound"
        }
      ],

      "enforcement_mechanisms": {
        "description": "Platform-specific enforcement strategies. The sandbox runner selects the best available mechanism at runtime.",

        "darwin": {
          "primary": "sandbox-exec",
          "profile_template": "(version 1)(deny default)(allow network* (local ip \"localhost:*\"))(allow file-read* (subpath \"{chroot_dir}\") (subpath \"{project_root}\"))(allow file-write* (subpath \"{chroot_dir}\"))(allow process-exec (path \"/usr/bin/python3\") (path \"/usr/local/bin/python3\") (path \"/usr/bin/env\"))",
          "fallback": "environment_only"
        },

        "linux": {
          "primary": "unshare_network_namespace",
          "command": "unshare --net --map-root-user",
          "secondary": "seccomp_bpf",
          "seccomp_blocked_syscalls": [
            "connect",
            "sendto",
            "sendmsg",
            "socket"
          ],
          "fallback": "iptables_owner_match",
          "iptables_rule_template": "iptables -A OUTPUT -m owner --uid-owner {sandbox_uid} -j DROP"
        },

        "windows": {
          "primary": "windows_job_object",
          "job_limits": {
            "limit_network": true,
            "limit_affinity": true,
            "limit_process_memory_mb": 1024
          },
          "secondary": "windows_firewall_rule",
          "firewall_rule_template": "netsh advfirewall firewall add rule name=\"AIDE_Sandbox_{sandbox_id}\" dir=out action=block program=\"{sandbox_executable}\"",
          "fallback": "environment_only"
        }
      }
    }
  },

  "process": {
    "resource_limits": {
      "max_runtime_seconds": 120,
      "max_cpu_percent": 90,
      "max_memory_mb": 1024,
      "max_child_processes": 8,
      "max_threads": 64,
      "max_open_files": 256,
      "max_disk_write_mb": 512,

      "oom_kill_enabled": true,
      "oom_score_adjust": 1000,

      "signals": {
        "graceful_shutdown": "SIGTERM",
        "graceful_timeout_seconds": 5,
        "force_kill": "SIGKILL"
      }
    },

    "execution_restrictions": {
      "deny_subprocess_spawn": false,
      "allowed_subprocess_commands": [
        "python3",
        "python",
        "node",
        "npm",
        "npx",
        "pip",
        "pip3",
        "uvicorn",
        "gunicorn",
        "fastapi"
      ],

      "denied_subprocess_commands": [
        "bash",
        "sh",
        "zsh",
        "fish",
        "dash",
        "csh",
        "tcsh",
        "ksh",
        "cmd",
        "cmd.exe",
        "powershell",
        "pwsh",
        "powershell.exe",
        "curl",
        "wget",
        "nc",
        "netcat",
        "ncat",
        "ssh",
        "scp",
        "sftp",
        "rsync",
        "ftp",
        "telnet",
        "nmap",
        "socat",
        "rm",
        "rmdir",
        "del",
        "format",
        "mkfs",
        "dd",
        "fdisk",
        "mount",
        "umount",
        "kill",
        "killall",
        "pkill",
        "shutdown",
        "reboot",
        "halt",
        "init",
        "systemctl",
        "service",
        "launchctl",
        "crontab",
        "at",
        "sudo",
        "su",
        "doas",
        "runas",
        "chmod",
        "chown",
        "chgrp",
        "chattr",
        "setfacl",
        "docker",
        "podman",
        "kubectl",
        "terraform",
        "ansible",
        "gcloud",
        "az",
        "aws",
        "git",
        "svn",
        "hg",
        "xdg-open",
        "open",
        "start",
        "xclip",
        "pbcopy",
        "xsel",
        "xdotool",
        "osascript"
      ],

      "deny_raw_socket": true,
      "deny_ptrace": true,
      "deny_kernel_module_load": true,
      "deny_mount_operations": true,
      "deny_capability_escalation": true,
      "deny_setuid": true,
      "deny_setgid": true
    }
  },

  "audit": {
    "logging": {
      "enabled": true,
      "log_file_pattern": "{chroot_dir}/sandbox_audit_{timestamp}.jsonl",
      "log_level": "info",

      "logged_events": [
        "sandbox_create",
        "sandbox_destroy",
        "process_start",
        "process_exit",
        "file_write",
        "network_attempt",
        "resource_limit_hit",
        "policy_violation",
        "signal_sent",
        "subprocess_spawn"
      ],

      "log_entry_schema": {
        "timestamp_iso": "string",
        "event_type": "string",
        "sandbox_id": "string",
        "pid": "integer",
        "details": "object",
        "severity": "enum[info,warning,violation,critical]"
      }
    },

    "violation_response": {
      "on_filesystem_violation": "kill_and_report",
      "on_network_violation": "kill_and_report",
      "on_subprocess_violation": "kill_and_report",
      "on_resource_limit_exceeded": "kill_and_report",
      "report_includes_stack_trace": true,
      "preserve_chroot_on_violation": true
    }
  }
}
