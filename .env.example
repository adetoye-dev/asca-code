# ACSA Code — environment configuration
#
# Copy to `.env` (or `$ACSA_DATA_DIR/.env`) and fill in what you need:
#
#     cp .env.example .env && chmod 600 .env
#
# Anything set here is authoritative: it overrides whatever is stored in the
# application database, so an operator can hand a machine a credential without
# writing it into app state, and CI or a container needs no database at all.
#
# Keep this file out of version control — only `.env.example` is committed.

# ── Storage ──────────────────────────────────────────────────────────────────
# Where the app keeps its own state (database, logs). Defaults to the platform
# application-data directory: ~/Library/Application Support/ACSA Code on macOS,
# %APPDATA%\ACSA Code on Windows, $XDG_DATA_HOME/acsa-code on Linux.
# ACSA_DATA_DIR=/path/to/data

# ── Model provider credentials ───────────────────────────────────────────────
# A provider-specific variable wins over the generic one, and either wins over a
# credential stored in the app database.
#
# ACSA_OPENAI_API_KEY=
# ACSA_ANTHROPIC_API_KEY=
# ACSA_DEEPSEEK_API_KEY=
# ACSA_GROQ_API_KEY=
# ACSA_MISTRAL_API_KEY=
# ACSA_XAI_API_KEY=
# ACSA_GOOGLE_API_KEY=
# ACSA_OPENROUTER_API_KEY=
#
# Generic fallback when no provider-specific key matches.
# ACSA_API_KEY=
# AIDE_API_KEY=
#
# Any other secret can be stored under its own name; the engine can read it and
# the UI never receives the value:
# ACSA_SECRET_DEPLOY_TOKEN=

# ── Engine tuning ────────────────────────────────────────────────────────────
# Output budget per agent round. A tool call carrying a whole file needs room;
# too small and the response is cut off mid-argument.
# ACSA_AGENT_MAX_TOKENS=8192
#
# Native function calling. 1 forces it on for local Ollama too, 0 disables it.
# Cloud providers get it by default.
# ACSA_NATIVE_TOOLS=
#
# Route short, single-target edits to the local worker to save cloud spend.
# ACSA_ROUTE_SIMPLE_TO_LOCAL=0

# ── Release signing (CI only — never commit real values) ─────────────────────
# Auto-update manifest signing. The public half goes in
# .tauri/tauri.conf.json under plugins.updater.pubkey.
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
#
# macOS notarisation.
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
